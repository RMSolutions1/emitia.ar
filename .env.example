# Copiá este archivo a .env.local:
#   cp .env.example .env.local

# --- Local (Docker: npm run db:local) ---
DATABASE_URL=postgresql://emitia:emitia_dev_local@localhost:5434/emitia_dev?connect_timeout=15
NEXTAUTH_URL=http://localhost:3000

# --- Vercel ---
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require&connect_timeout=15
# NEXTAUTH_URL=https://tu-proyecto.vercel.app

NEXTAUTH_SECRET=generate-a-strong-secret
ENCRYPTION_SECRET=generate-a-strong-secret

# AFIP / ARCA
AFIP_CERT=base64-encoded-cert
AFIP_KEY=base64-encoded-key
AFIP_CUIT=20401546228
AFIP_ENVIRONMENT=homologation

# IA — al menos uno (orden: OpenAI → Gemini → Anthropic → Ollama)
# Gemini: https://aistudio.google.com/apikey
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=openai

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=EMITIA <noreply@tu-dominio.com>

# MercadoPago (opcional)
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
